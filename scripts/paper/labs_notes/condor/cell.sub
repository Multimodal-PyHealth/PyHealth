# HTCondor wrapper: runs one Labs + Notes cell in the foreground on the assigned GPU.
#
#   mkdir -p $TREE/logs/condor
#   condor_submit CELL=run_rnn.sh TREE=/home/rianatri/ml4h-paper \
#       scripts/paper/labs_notes/condor/cell.sub
#
# The cells load a prebuilt task cache rather than building the dataset, so
# 64 GB of host RAM is ample.
TREE = /home/rianatri/ml4h-paper

initialdir          = $(TREE)
executable          = $(TREE)/scripts/paper/labs_notes/condor/cell.sh
transfer_executable = False
arguments           = $(CELL)
getenv              = True
environment         = "FOREGROUND=1 GPU= TREE=$(TREE)"

output = $(TREE)/logs/condor/$(CELL)_$(ClusterId).out
error  = $(TREE)/logs/condor/$(CELL)_$(ClusterId).err
log    = $(TREE)/logs/condor/$(CELL)_$(ClusterId).log

request_gpus   = 1
request_cpus   = 4
request_memory = 65536

queue
